<script>
window.harmonyConfig = {
    urls: {
        getUserLikes: '@Url.Action("GetUserLikes",       "Clients")',
        likeContent:  '@Url.Action("LikeContent",        "Clients")',
        checkPremium: '@Url.Action("CheckPremiumStatus", "Clients")',
        getRandomAd:  '@Url.Action("GetRandomAd",        "Clients")'
    },
    userId: '@ViewBag.UserId'
};

function redirectToPlaylistsWithContent(contentId) {
    window.location.href = '@Url.Action("Index", "Playlists")?contentId=' + contentId;
}

// ==========================================================================
// PAGINACIÓN POR CATEGORÍA (client-side, sin recargar la página)
// ==========================================================================
const CATEGORY_PAGE_SIZE = 5;
const categoryState = {};

function initCategoryPagination() {
    document.querySelectorAll('.tab-pane').forEach(function (pane) {
        categoryState[pane.id] = { page: 1 };
        renderCategoryPage(pane.id, 1);
    });
}

function renderCategoryPage(tabId, page) {
    var pane = document.getElementById(tabId);
    if (!pane) return;

    // Solo se pagina sobre items visibles según el buscador
    var items = Array.prototype.slice.call(pane.querySelectorAll('.song-item:not(.search-hidden)'));
    var totalItems = items.length;
    var totalPages = Math.max(1, Math.ceil(totalItems / CATEGORY_PAGE_SIZE));

    if (page < 1) page = 1;
    if (page > totalPages) page = totalPages;
    categoryState[tabId] = categoryState[tabId] || {};
    categoryState[tabId].page = page;

    items.forEach(function (item, idx) {
        var itemPage = Math.floor(idx / CATEGORY_PAGE_SIZE) + 1;
        item.classList.toggle('page-hidden', itemPage !== page);
    });

    var info = pane.querySelector('.cat-page-info');
    if (info) info.textContent = 'Página ' + page + ' de ' + totalPages;

    var prevBtn = pane.querySelector('.cat-prev');
    var nextBtn = pane.querySelector('.cat-next');
    if (prevBtn) prevBtn.disabled = page <= 1;
    if (nextBtn) nextBtn.disabled = page >= totalPages;

    var paginationEl = pane.querySelector('.category-pagination');
    if (paginationEl) paginationEl.style.display = totalPages > 1 ? 'flex' : 'none';
}

// Delegación de eventos para los botones Anterior/Siguiente de cada categoría
document.addEventListener('click', function (e) {
    var prev = e.target.closest('.cat-prev');
    var next = e.target.closest('.cat-next');
    if (prev) {
        var tabId = prev.getAttribute('data-target').replace('#', '');
        renderCategoryPage(tabId, (categoryState[tabId]?.page || 1) - 1);
    } else if (next) {
        var tabId2 = next.getAttribute('data-target').replace('#', '');
        renderCategoryPage(tabId2, (categoryState[tabId2]?.page || 1) + 1);
    }
});

// NUEVA FUNCIÓN: Control manual para asegurar que se desplieguen las canciones
function handleCategoryTabClick(button) {
    resetSearchBar();

    // Obtener el ID del contenedor de canciones correspondiente
    const targetSelector = button.getAttribute('data-bs-target');
    const targetPane = document.querySelector(targetSelector);

    if (!targetPane) return;

    // 1. Desactivar todos los botones de categorías
    document.querySelectorAll('.category-tab-btn').forEach(btn => {
        btn.classList.remove('active');
        btn.setAttribute('aria-selected', 'false');
    });

    // 2. Ocultar todas las listas de canciones abiertas
    document.querySelectorAll('.tab-content .tab-pane').forEach(pane => {
        pane.classList.remove('show', 'active');
    });

    // 3. Activar visualmente la tarjeta clickeada y mostrar sus canciones
    button.classList.add('active');
    button.setAttribute('aria-selected', 'true');
    targetPane.classList.add('show', 'active');

    // 4. Reiniciar a la página 1 cada vez que se abre la categoría
    renderCategoryPage(targetPane.id, 1);
}

function filterLibrary() {
    var input = document.getElementById('librarySearch');
    if (!input) return;
    var q = input.value.trim().toLowerCase();
    var searching = q.length > 0;
    var items = document.querySelectorAll('.songs-list .song-item');
    var visible = 0;

    items.forEach(function (item) {
        var haystack = item.getAttribute('data-search') || '';
        var match = haystack.indexOf(q) !== -1;
        item.classList.toggle('search-hidden', !match);
        if (match) visible++;
    });

    document.querySelectorAll('.tab-pane').forEach(function (pane) {
        if (searching) {
            // Mientras se busca, se ignora la paginación y se muestran todos los coincidentes
            pane.querySelectorAll('.song-item').forEach(function (item) {
                item.classList.remove('page-hidden');
            });
            var paginationEl = pane.querySelector('.category-pagination');
            if (paginationEl) paginationEl.style.display = 'none';
        } else {
            renderCategoryPage(pane.id, 1);
        }
    });

    var noResults = document.getElementById('noLibraryResults');
    if (noResults) noResults.style.display = (visible === 0) ? '' : 'none';
}

function closeCategoryTab() {
    document.querySelectorAll('.category-tab-btn').forEach(btn => {
        btn.classList.remove('active');
        btn.setAttribute('aria-selected', 'false');
    });
    document.querySelectorAll('.tab-content .tab-pane').forEach(pane => {
        pane.classList.remove('show', 'active');
    });
}

function resetSearchBar() {
    const searchInput = document.getElementById('librarySearch');
    if (searchInput) {
        searchInput.value = '';
        filterLibrary();
    }
}

document.addEventListener('DOMContentLoaded', initCategoryPagination);
</script>
<script src="~/js/harmony-player.js"></script>
