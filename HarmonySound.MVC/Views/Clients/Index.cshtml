@model IEnumerable<HarmonySound.MVC.Models.ContentWithArtistDto>

@{
    ViewData["Title"] = "Contenido de Audio";
}

<div class="music-library-container">
    <div class="library-header">
        <div class="navigation-bar">
            <a href="@Url.Action("Home", "Clients")" class="btn-home">
                <i class="fas fa-home me-2"></i>
                Home
            </a>
        </div>

        <div class="logout-section">
            <form asp-action="Logout" asp-controller="Account" method="post" class="logout-form">
                <button type="submit" class="btn-logout">
                    <i class="fas fa-sign-out-alt me-2"></i>
                    Cerrar Sesión
                </button>
            </form>
        </div>

        <h1 class="library-title">
            <i class="fas fa-music me-3"></i>
            Biblioteca Musical
        </h1>
        <p class="library-subtitle">Descubre y reproduce tu música favorita</p>
    </div>

    <div class="search-container">
        <div class="search-input-group">
            <i class="fas fa-search search-icon"></i>
            <input type="text" id="librarySearch" class="search-input"
                   placeholder="Buscar canciones o artistas..." oninput="filterLibrary()" autocomplete="off" />
        </div>
    </div>

    @if (Model?.Any() == true)
    {
        @* Agrupación automática por el campo Type *@
        var categories = Model.GroupBy(c => c.Type).ToList();

        <div class="categories-section mb-4">
            <div class="cards-grid category-cards-tabs mb-4" role="tablist">
                @foreach (var category in categories)
                {
                    var typeName = category.Key ?? "Otros";
                    var totalItems = category.Count();
                    var tabId = "cat-" + typeName.Replace(" ", "-").ToLower();

                    <button class="media-card category-tab-btn"
        id="@(tabId)-tab"
        data-bs-toggle="tab"
        data-bs-target="#@tabId"
        type="button"
        role="tab"
        aria-controls="@tabId"
        aria-selected="false"
        onclick="handleCategoryTabClick(this)">
                        <div class="media-cover">
                            <div class="media-cover-placeholder">
                                @if (typeName.ToLower().Contains("podcast"))
                                {
                                    <i class="fas fa-microphone-alt"></i>
                                }
                                else if (typeName.ToLower().Contains("cancion") || typeName.ToLower().Contains("música") || typeName.ToLower().Contains("music"))
                                {
                                    <i class="fas fa-music"></i>
                                }
                                else
                                {
                                    <i class="fas fa-compact-disc"></i>
                                }
                            </div>
                            <div class="media-play"><i class="fas fa-folder-open"></i></div>
                        </div>
                        <div class="media-card-info text-start">
                            <div class="media-card-title text-capitalize">@typeName</div>
                            <div class="media-card-subtitle">@totalItems @(totalItems == 1 ? "elemento" : "elementos")</div>
                        </div>
                    </button>
                }
            </div>

            <div class="tab-content">
                @foreach (var category in categories)
                {
                    var typeName = category.Key ?? "Otros";
                    var tabId = "cat-" + typeName.Replace(" ", "-").ToLower();

                    <div class="tab-pane fade" id="@tabId" role="tabpanel" aria-labelledby="@(tabId)-tab">
                        <div class="songs-container">
                            <div class="songs-header d-flex align-items-center justify-content-between mb-3">
                                <h2 class="text-capitalize mb-0">
                                    <i class="fas fa-list me-2"></i>@typeName
                                </h2>
                                <button class="btn btn-sm btn-outline-light btn-close-category" onclick="closeCategoryTab()" style="border-radius: 20px; font-size: 0.8rem;">
                                    <i class="fas fa-times me-1"></i> Cerrar sección
                                </button>
                            </div>

                            <div class="songs-list" id="list-@tabId">
                                @foreach (var content in category)
                                {
                                    <div class="song-item" data-content-id="@content.Id" data-search="@(((content.Title ?? "") + " " + (content.ArtistName ?? "")).ToLower())">
                                        <div class="song-main-info">
                                            <div class="song-cover">
                                                <div class="cover-placeholder">
                                                    @if (typeName.ToLower().Contains("podcast"))
                                                    {
                                                        <i class="fas fa-microphone"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="fas fa-music"></i>
                                                    }
                                                </div>
                                            </div>

                                            <div class="song-details">
                                                <div class="song-title">@content.Title</div>
                                                <div class="song-meta">
                                                    <span class="content-type">@content.Type</span>
                                                    <span class="artist-name">@content.ArtistName</span>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="song-actions">
                                            <button class="btn btn-like like-btn"
                                                    data-content-id="@content.Id"
                                                    data-user-id="@ViewBag.UserId"
                                                    title="Me gusta">
                                                <i class="far fa-heart"></i>
                                            </button>

                                            <button class="btn btn-playlist"
                                                    onclick="redirectToPlaylistsWithContent(@content.Id)"
                                                    title="Agregar a Playlist">
                                                <i class="fas fa-plus"></i>
                                            </button>

                                            <button class="btn btn-play play-in-player-btn"
                                                    data-content-id="@content.Id"
                                                    data-title="@content.Title"
                                                    data-artist="@content.ArtistName"
                                                    data-url="@content.UrlMedia"
                                                    title="Reproducir">
                                                <i class="fas fa-play"></i>
                                            </button>
                                        </div>

                                        <div class="song-duration">
                                            <i class="fas fa-clock me-1"></i>
                                            <span>@content.FormattedDuration</span>
                                        </div>
                                    </div>
                                }
                            </div>

                            @* Paginación propia de esta categoría, controlada 100% por JS (sin recargar la página) *@
                            <div class="category-pagination" data-tab-id="@tabId" style="display:none;">
                                <button class="btn-pagination cat-prev" data-target="#@tabId" type="button">
                                    <i class="fas fa-chevron-left me-1"></i> Anterior
                                </button>
                                <span class="pagination-info cat-page-info">Página 1 de 1</span>
                                <button class="btn-pagination cat-next" data-target="#@tabId" type="button">
                                    Siguiente <i class="fas fa-chevron-right ms-1"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <div id="noLibraryResults" class="no-results" style="display:none; margin-top: 20px;">
        <div class="no-results-icon"><i class="fas fa-search"></i></div>
        <h3>No se encontraron resultados</h3>
        <p>Prueba con otro título o nombre de artista</p>
    </div>

</div>

@await Html.PartialAsync("_PlayerBar")

@{
    var subscriptionStatus = ViewBag.SubscriptionStatus as dynamic;
}
@if (subscriptionStatus?.IsCancelled == true && subscriptionStatus?.IsActive == true)
{
    <div class="subscription-status-banner">
        <div class="banner-content">
            <i class="fas fa-info-circle"></i>
            <div class="banner-text">
                <strong>Plan cancelado:</strong>
                Tienes acceso premium hasta el @subscriptionStatus.EndDate.ToString("dd/MM/yyyy")
            </div>
            <a href="@Url.Action("Index", "Plans")" class="banner-action">Reactivar</a>
        </div>
    </div>
}

