        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
        margin-top: 1rem;
        padding: 10px;
    }

    /* ==========================================================================
       NUEVOS ESTILOS AGREGADOS REQUERIDOS PARA LAS TARJETAS DINÁMICAS (TABS)
       ========================================================================== */
    .cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 24px;
    }
    .category-tab-btn {
        background: var(--us-surface-alt, #181818);
        border: 1px solid var(--us-border, #282828);
